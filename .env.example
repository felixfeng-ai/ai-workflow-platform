# 雅秩 - 生产环境配置模板
# 复制为 .env 后修改：cp .env.example .env   （.env 被 git 忽略，勿提交）
# 生成强随机 JWT 密钥：openssl rand -hex 32

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=projecthub
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=change-me            # 生产必须改为强密码

# ── 后端（容器内主机名 postgres/redis 对应 compose 服务名）──
DATABASE_URL=postgresql+asyncpg://projecthub:change-me@postgres:5432/projecthub
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-with-openssl-rand-hex-32   # 必改：覆盖代码里的 dev 默认值
# 代码分析仓库凭据加密密钥。生产必须独立生成，例如 openssl rand -hex 32
APP_ENCRYPTION_KEY=change-me-with-openssl-rand-hex-32

# ── GitHub Actions 部署 ────────────────────────────────────
# 由平台管理员配置一次，普通项目用户无需填写。
# Fine-grained PAT 需要目标仓库 Actions: Read and write、Metadata: Read-only。
GITHUB_DEPLOY_TOKEN=

# ── 代码提交分析 ───────────────────────────────────────────
CODE_ANALYSIS_MAX_FILES=50
CODE_ANALYSIS_MAX_PATCH_CHARS=120000
CODE_ANALYSIS_AI_ENABLED=true
CODE_ANALYSIS_TIMEOUT=180

# ── AI 引擎选择 ─────────────────────────────────────────────
# ai_provider: dify（Dify CE headless）| openai_compatible（DeepSeek/通义等 OpenAI 协议端点）
AI_PROVIDER=dify
# openai_compatible 模式时填（Dify 用不到可留空）
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-chat

# ── Dify CE（可选，--profile dify 时后端直连 api 服务）────
DIFY_API_URL=http://api:5001/v1
DIFY_API_KEY=
# Dify 自身凭据（compose.dify.yml 使用）
DIFY_SECRET_KEY=
DIFY_DB_HOST=dify-postgres
DIFY_DB_USERNAME=dify
DIFY_DB_PASSWORD=change-me
DIFY_DB_DATABASE=dify
DIFY_REDIS_HOST=dify-redis
DIFY_REDIS_PASSWORD=

# ── 微信订阅消息（与小程序端 TARO_APP_TEMPLATE_DUE 对应）──
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TEMPLATE_DUE=
